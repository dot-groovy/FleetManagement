@{
    ViewData["Title"] = "Exportar PDF";
}

<h1>Exportar Documentos</h1>
<p class="text-muted">Escolha o que deseja exportar em PDF:</p>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success">@TempData["MensagemSucesso"]</div>
}
@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger">@TempData["MensagemErro"]</div>
}

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Motoristas</h5>
                <p class="card-text">Exportar lista de motoristas</p>
                <a asp-action="ExportPdf" asp-route-tipo="motoristas" class="btn btn-primary mb-2">Exportar PDF</a>
                <form asp-action="EnviarEmail" method="post" class="mt-2">
                    <input type="hidden" name="tipo" value="motoristas" />
                    <div class="input-group input-group-sm">
                        <input type="email" name="email" class="form-control" placeholder="Email para enviar" required />
                        <button type="submit" class="btn btn-outline-primary">Enviar por email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Veiculos</h5>
                <p class="card-text">Exportar lista de veiculos</p>
                <a asp-action="ExportPdf" asp-route-tipo="veiculos" class="btn btn-primary mb-2">Exportar PDF</a>
                <form asp-action="EnviarEmail" method="post" class="mt-2">
                    <input type="hidden" name="tipo" value="veiculos" />
                    <div class="input-group input-group-sm">
                        <input type="email" name="email" class="form-control" placeholder="Email para enviar" required />
                        <button type="submit" class="btn btn-outline-primary">Enviar por email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Manutenções</h5>
                <p class="card-text">Exportar historico de manutenções</p>
                <a asp-action="ExportPdf" asp-route-tipo="manutencoes" class="btn btn-primary mb-2">Exportar PDF</a>
                <form asp-action="EnviarEmail" method="post" class="mt-2">
                    <input type="hidden" name="tipo" value="manutencoes" />
                    <div class="input-group input-group-sm">
                        <input type="email" name="email" class="form-control" placeholder="Email para enviar" required />
                        <button type="submit" class="btn btn-outline-primary">Enviar por email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
